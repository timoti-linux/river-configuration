{
    "layer": "top",
    "position": "top",
    "width": 1896,

    "modules-left": ["river/tags"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "memory", "pulseaudio", "battery"],

    "river/tags": {
        "num-tags": 6
    },
    "pulseaudio": {
        "format": "{icon} ",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        }
    },
    "memory": {
        "format": "{used:0.1f}G"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} ",
        "format-charging": "{capacity}%",
        "format-plugged": "{capacity}%",
        "format-icons": ["", "", "", "", ""]
    }
}
